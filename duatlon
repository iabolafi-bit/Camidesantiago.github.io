                        serif: ['Cinzel', 'Georgia', 'serif'],
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                    },
                    colors: {
                        lightBg: '#dbeafe', // Lighter blue sport-ice background
                        lightCard: '#ffffff', // Crisp white cards
                        lightBorder: '#dbeafe', // Soft electric blue border
                        accentYellow: '#f59e0b', // Highly vibrant solar gold for Trail/highlights
                        accentYellowHover: '#d97706', // Deep amber yellow
                        accentBlue: '#2563eb', // Electric royal blue
                        accentBlueHover: '#1d4ed8', // Deep royal blue
                        accentCyan: '#0ea5e9', // Bright Cyan indicator
                        textDark: '#1e3a8a', // Deep blue high-contrast text
                        textMuted: '#475569', // Readability secondary text (slate)
                    }
                }
            }
        }
