            const distanceEl = document.getElementById('route-carousel-distance');

            // Update background image based on route
            let bgImage = 'linear-gradient(to bottom, rgba(239, 246, 255, 0.92), rgba(219, 234, 254, 0.98)), url(\'https://images.unsplash.com/photo-1441974231531-c6227db76b6e?auto=format&fit=crop&w=600&q=80\')';
            let iconClass = 'fa-flag';
            let badgeText = 'RUTA DELS TEMPLERS';
            let badgeColor = 'text-accentYellow';
            let iconBgColor = 'bg-accentYellow';

            if (routeId === 'nord') {
                bgImage = 'linear-gradient(to bottom, rgba(239, 246, 255, 0.92), rgba(219, 234, 254, 0.98)), url(\'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=600&q=80\')';
                iconClass = 'fa-mountain';
                badgeText = 'COSTA ASTURIANA';
                badgeColor = 'text-accentCyan';
                iconBgColor = 'bg-blue-100 text-accentBlue';
            } else if (routeId === 'portugues') {
                bgImage = 'linear-gradient(to bottom, rgba(239, 246, 255, 0.92), rgba(219, 234, 254, 0.98)), url(\'https://images.unsplash.com/photo-1542273917363-3b1817f69a2d?auto=format&fit=crop&w=600&q=80\')';
                iconClass = 'fa-tree';
                badgeText = 'BOSCOS DE GALÍCIA SUD';
                badgeColor = 'text-accentBlue';
                iconBgColor = 'bg-blue-100 text-accentBlue';
            }

            card.style.backgroundImage = bgImage;
            
            // Update icon
            iconEl.className = `w-10 h-10 rounded-xl ${iconBgColor} flex items-center justify-center font-black text-lg shadow-md group-hover:rotate-6 transition-transform`;
            iconEl.innerHTML = `<i class="fa-solid ${iconClass}"></i>`;

            // Update texts
            badgeEl.innerText = badgeText;
            badgeEl.className = `text-[10px] ${badgeColor} uppercase tracking-widest font-extrabold`;
            titleEl.innerText = route.title.split(' (')[0]; // Remove parentheses part
            descEl.innerText = route.desc;
            stagesEl.innerText = `${route.stages} Etapes`;
            distanceEl.innerText = `${route.stages * 25} km total`; // Rough estimate
        }

        function switchRoute(routeId) {
            currentRouteId = routeId;
            const route = routesData[routeId];

            // Update route carousel card
            updateRouteCarouselCard(routeId);
           
            document.getElementById('route-title').innerText = route.title;
            document.getElementById('route-badge').innerText = route.badge;
            document.getElementById('route-desc').innerText = route.desc;
            document.getElementById('route-dist-trail').innerText = route.distTrail;
            document.getElementById('route-dist-btt').innerText = route.distBtt;
            document.getElementById('route-stages').innerText = `${route.stages} Etapes (${route.stages} Nits)`;
           
            document.getElementById('tech-endpoints').innerText = route.endpoints;
            document.getElementById('tech-difficulty').innerText = route.difficulty;
            document.getElementById('tech-terrain').innerText = route.terrain;
            document.getElementById('tech-shoes').innerText = route.shoes;
            document.getElementById('tech-tires').innerText = route.tires;

            updateCarouselPreview(routeId);
            renderRouteCardContent(routeId);
            activeDayNum = 1;
            setupDayTabs(routeId);
            selectDay(1);
           
            // Sync budget inputs dropdown
            const selectEl = document.getElementById('sim-route');
            if (selectEl && selectEl.value !== routeId) {
                selectEl.value = routeId;
            }

            // Sync Requirements Spinner wheel if not already synced
            const idx = wheelRoutesOrder.indexOf(routeId);
            if (idx !== -1 && idx !== activeWheelIndex) {
                spinToRouteIndex(idx);
            }

            calculateBudget();
            setTimeout(resizeCanvas, 50);
        }

        function updateCarouselPreview(routeId) {
            const route = routesData[routeId];
            if (!route) return;

            const titleEl = document.getElementById('carousel-route-title');
            const descEl = document.getElementById('carousel-route-desc');
            const stagesEl = document.getElementById('carousel-route-stages');
            const priceEl = document.getElementById('carousel-route-price');

            if (titleEl) titleEl.innerText = route.title;
            if (descEl) descEl.innerText = route.desc;
            if (stagesEl) stagesEl.innerText = route.stages;
            if (priceEl) priceEl.innerText = `${route.basePrice} €`;
        }

        // ACCOMMODATION SELECTION SYSTEM
        function selectAccommodation(option) {
            selectedAccommodationOption = option;
            document.querySelectorAll('.acc-card').forEach(card => {
                card.classList.remove('border-accentBlue');
                card.classList.add('border-blue-200');
            });
            document.querySelectorAll('.acc-card div[id$="-dot"]').forEach(dot => {
                dot.classList.remove('bg-accentBlue');
                dot.classList.add('bg-transparent');
            });
           
            const targetCard = document.getElementById(`acc-${option}`);
            const targetDot = document.getElementById(`acc-${option}-dot`);
            if (targetCard && targetDot) {
                targetCard.classList.remove('border-blue-200');
                targetCard.classList.add('border-accentBlue');
                targetDot.classList.remove('bg-transparent');
                targetDot.classList.add('bg-accentBlue');
            }
           
            calculateBudget();
        }

        function toggleExtra(extraId) {
            extrasState[extraId] = !extrasState[extraId];
            const card = document.getElementById(`ext-${extraId}`);
            const chk = document.getElementById(`chk-${extraId}`);
           
            if (extrasState[extraId]) {
                card.classList.remove('border-blue-200');
                card.classList.add('border-accentBlue');
                chk.classList.remove('text-transparent', 'bg-slate-100');
                chk.classList.add('text-white', 'bg-accentBlue');
            } else {
                card.classList.remove('border-accentBlue');
                card.classList.add('border-blue-200');
                chk.classList.remove('text-white', 'bg-accentBlue');
                chk.classList.add('text-transparent', 'bg-slate-100');
            }
            calculateBudget();
        }

        // FINAL BILLING CALCULATOR FORMULA
        function calculateBudget() {
            const selectEl = document.getElementById('sim-route');
            if (!selectEl) return;
            const routeId = selectEl.value;
            const route = routesData[routeId];
            const nights = route.stages;
           
            let total = route.basePrice;
           
            let accPrice = 0;
            if (selectedAccommodationOption === 'alberg') accPrice = 25 * nights;
            if (selectedAccommodationOption === 'hotel') accPrice = 55 * nights;
            total += accPrice;

            const fisioPrice = extrasState.fisioterapia ? 45 * route.stages : 0;
            const fotosPrice = extrasState.fotos ? 25 : 0;
            const biciPrice = extrasState.bici ? 75 : 0;
            const rafflePrice = document.getElementById('premium-ticket-chk').checked ? 10 : 0;

            total += fisioPrice + fotosPrice + biciPrice + rafflePrice;

            document.getElementById('invoice-base').innerText = route.basePrice + ' €';
            document.getElementById('invoice-nights-desc').innerText = nights + ' nits';
            document.getElementById('invoice-acc').innerText = accPrice + ' €';
            document.getElementById('invoice-fisioterapia').innerText = fisioPrice + ' €';
            document.getElementById('invoice-fotos').innerText = fotosPrice + ' €';
            document.getElementById('invoice-bici').innerText = biciPrice + ' €';
            document.getElementById('invoice-raffle').innerText = rafflePrice + ' €';
            document.getElementById('invoice-total').innerText = total + ' €';
           
            document.getElementById('sim-nights-badge').innerText = nights + ' Nits';
        }

        function scrollToBudgetAndSelectRaffle() {
            document.getElementById('calculadora').scrollIntoView({ behavior: 'smooth' });
            document.getElementById('premium-ticket-chk').checked = true;
            calculateBudget();
        }

        function openRegistrationModal() {
            const selectEl = document.getElementById('sim-route');
            const routeId = selectEl.value;
            document.getElementById('modal-route-display').innerText = routesData[routeId].title;
            document.getElementById('modal-price-display').innerText = document.getElementById('invoice-total').innerText;
           
            const modal = document.getElementById('register-modal');
            modal.classList.remove('opacity-0', 'pointer-events-none');
        }

        function closeRegistrationModal() {
            document.getElementById('register-modal').classList.add('opacity-0', 'pointer-events-none');
        }

        function handleRegistrationSubmit(e) {
            e.preventDefault();

            const form = e.currentTarget;
            const routeId = document.getElementById('sim-route')?.value || 'frances';
            const routeTitle = routesData[routeId].title;
            const totalPrice = document.getElementById('invoice-total').innerText;

            document.getElementById('form-route-hidden').value = routeTitle;
            document.getElementById('form-price-hidden').value = totalPrice;

            const submitBtn = form.querySelector('button[type="submit"]');
            submitBtn.disabled = true;
            submitBtn.textContent = 'Enviant...';

            fetch(form.action, {
                method: 'POST',
                body: new FormData(form),
                headers: {
                    'Accept': 'application/json'
                }
            })
            .then(async response => {
                const data = await response.json().catch(() => ({ ok: true }));
                if (!response.ok || !data.ok) {
                    throw new Error(data.message || 'Error al enviar la inscripció');
                }
                form.reset();
                closeRegistrationModal();
                showToast('Inscripció enviada correctament!');
            })
            .catch(error => {
                console.error(error);
                closeRegistrationModal();
                showToast('No s\'ha pogut enviar. Revisau la configuració del correu del servidor.');
            })
            .finally(() => {
                submitBtn.disabled = false;
                submitBtn.textContent = 'Finalitzar i Pagar Reserva';
            });
        }

        function showToast(msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-message').innerText = msg;
            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 4000);
        }
    </script>
</body>
</html>
