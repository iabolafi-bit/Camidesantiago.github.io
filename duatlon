                            <div class="flex items-center justify-between mt-3 pt-3 border-t border-blue-200 text-xs font-bold text-textDark">
                                <span id="route-carousel-stages">4 Etapes</span>
                                <span id="route-carousel-distance" class="text-accentBlue font-mono">115 km total</span>
                            </div>
                        </div>
                    </div>

                    <!-- Content Grid (Info + Chart) -->
                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 p-8 items-stretch">
               
                        <!-- Info Column (Left) -->
