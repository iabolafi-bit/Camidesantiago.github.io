                <button onclick="spinWheelPrev()" aria-label="Ruta anterior" class="absolute left-0 top-1/2 -translate-y-1/2 -ml-6 w-14 h-14 rounded-full bg-accentYellow text-white shadow-lg hover:bg-accentYellowHover transition-colors z-10">
                    <i class="fa-solid fa-chevron-left text-2xl"></i>
                </button>
                <button onclick="spinWheelNext()" aria-label="Següent ruta" class="absolute right-0 top-1/2 -translate-y-1/2 -mr-6 w-14 h-14 rounded-full bg-accentYellow text-white shadow-lg hover:bg-accentYellowHover transition-colors z-10">
                    <i class="fa-solid fa-chevron-right text-2xl"></i>
                </button>

                <!-- Single Unified Card -->
