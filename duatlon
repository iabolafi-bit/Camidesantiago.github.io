                    <div>
                        <!-- Badge dynamic -->
                        <div class="inline-block bg-accentYellow/10 text-accentYellow border border-accentYellow/20 text-[10px] uppercase tracking-widest font-extrabold px-3 py-1 rounded-full mb-4" id="route-badge">
                            MÍTICA RUTA DELS TEMPLERS
                        </div>
                       
                        <!-- Route Title Dynamic -->
                        <h3 class="font-serif text-2xl sm:text-3xl font-bold text-textDark mb-4 leading-tight uppercase" id="route-title">
