                                <p class="flex justify-between"><span class="text-textMuted font-bold">Exigència Física:</span> <span class="font-black text-accentBlue" id="tech-difficulty">Mitjana</span></p>
                                <p class="flex justify-between"><span class="text-textMuted font-bold">Tipus Terreny:</span> <span class="font-bold text-textDark" id="tech-terrain">Pistes, senders i camins de terra</span></p>
                                <p class="flex justify-between"><span class="text-textMuted font-bold">Bambes Trail:</span> <span class="font-bold text-textMuted" id="tech-shoes">Sola taquejat mitjà</span></p>
                                <p class="flex justify-between"><span class="text-textMuted font-bold">Pneumàtic BTT:</span> <span class="font-bold text-textMuted" id="tech-tires">Gravel/MTB mixt 2.1"</span></p>
                            </div>
                        </div>
                    </div>

                    <!-- Distances specs -->
                    <div class="border-t border-blue-200 pt-6 space-y-4">
                        <div class="flex items-center justify-between text-sm sm:text-base">
                            <span class="text-textDark font-bold flex items-center gap-2">
                                <i class="fa-solid fa-person-running text-accentYellow text-lg"></i> Distància Trail (A Peu)
                            </span>
                            <span class="font-extrabold text-textDark font-mono" id="route-dist-trail">35 km</span>
                        </div>
                        <div class="flex items-center justify-between text-sm sm:text-base">
                            <span class="text-textDark font-bold flex items-center gap-2">
                                <i class="fa-solid fa-bicycle text-accentBlue text-lg"></i> Distància BTT / Gravel
                            </span>
                            <span class="font-extrabold text-textDark font-mono" id="route-dist-btt">80 km</span>
                        </div>
                        <div class="flex items-center justify-between text-sm sm:text-base">
                            <span class="text-textDark font-bold flex items-center gap-2">
                                <i class="fa-solid fa-calendar-days text-accentBlue text-lg"></i> Durada de la Cursa
                            </span>
                            <span class="font-extrabold text-textDark font-mono" id="route-stages">4 Etapes (4 Nits)</span>
                        </div>
                    </div>
                </div>

                        <!-- Interactive Chart Column (Right) -->
                        <div class="lg:col-span-8 bg-white/90 backdrop-blur-md flex flex-col justify-between">
                    <div>
                        <!-- Tabs & Title Header -->
                        <div class="flex flex-col xl:flex-row xl:items-center justify-between gap-4 mb-6">
                            <div>
                                <h4 class="font-serif text-lg sm:text-xl font-black text-textDark flex items-center gap-2">
                                    <i class="fa-solid fa-chart-area text-accentBlue"></i> PERFIL REAL PER ETAPES DIÀRIES
                                </h4>
                                <p class="text-textMuted text-xs mt-1 font-bold">Cada etapa comença amb Trail i acaba amb BTT/Gravel (Codi de colors)</p>
                            </div>
                           
                            <!-- Day Selection Tabs -->
                            <div class="flex flex-wrap gap-2" id="day-tabs-container">
                                <!-- Tabs dynamically injected here -->
                            </div>
                        </div>

                        <!-- Legend Indicator of color coding -->
