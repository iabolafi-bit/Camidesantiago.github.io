        function resizeCanvas() {
            const container = document.getElementById('canvas-container');
            const rect = container.getBoundingClientRect();

            const displayHeight = window.innerWidth < 640 ? 320 : 400;
           
            canvas.width = rect.width * dpr;
            canvas.height = displayHeight * dpr;
            canvas.style.width = rect.width + 'px';
            canvas.style.height = displayHeight + 'px';
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

            drawElevationChart();
        }

        // WHEEL SPINNER MATH & LOGIC
        function spinToRouteIndex(targetIndex, instant = false) {
            // Find minimal rotation direction (-1, 0, 1)
            let diff = targetIndex - activeWheelIndex;
            if (diff > 1) diff -= 3;
            if (diff < -1) diff += 3;

            // Increment cumulative degrees (Each step of 1 is 120 degrees)
            // Spin clockwise or counterclockwise based on calculation
            cumulativeRotationDegrees -= diff * 120;
            activeWheelIndex = targetIndex;

            const compassRing = document.getElementById('compass-ring');
            if (compassRing) {
                if (instant) {
                    compassRing.style.transition = 'none';
                    compassRing.style.transform = `rotate(${cumulativeRotationDegrees}deg)`;
