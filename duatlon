        function interpolateElevation(km, points) {
            if (km <= points[0].km) return points[0].alt;
            if (km >= points[points.length - 1].km) return points[points.length - 1].alt;

            for (let i = 0; i < points.length - 1; i++) {
                if (km >= points[i].km && km <= points[i + 1].km) {
                    const ratio = (km - points[i].km) / (points[i+1].km - points[i].km);
                    return points[i].alt + ratio * (points[i+1].alt - points[i].alt);
                }
            }
            return points[0].alt;
        }

        function calculateSlope(km, points, totalKm) {
            const step = 0.2;
            const kmPrev = Math.max(0, km - step);
            const kmNext = Math.min(totalKm, km + step);

            const altPrev = interpolateElevation(kmPrev, points);
            const altNext = interpolateElevation(kmNext, points);

            const distDiff = (kmNext - kmPrev) * 1000;
            if (distDiff === 0) return 0;

            const heightDiff = altNext - altPrev;
            const slope = (heightDiff / distDiff) * 100;
            return parseFloat(slope.toFixed(1));
        }

        // DRAW ELEVATION GRAPH ON WINDOW RESIZE/LOAD
        function drawElevationChart() {
            if (!canvas || !ctx) return;

            const width = canvas.width / dpr;
            const height = canvas.height / dpr;

            ctx.clearRect(0, 0, width, height);

            const route = routesData[currentRouteId];
            if (!route) return;
            const dayData = route.days.find(d => d.dayNum === activeDayNum) || route.days[0];

            const padding = { top: 40, right: 40, bottom: 50, left: 65 };
            const chartW = width - padding.left - padding.right;
            const chartH = height - padding.top - padding.bottom;
            if (chartW <= 0) return;

            const altitudes = dayData.points.map(p => p.alt);
            const minAlt = Math.max(0, Math.min(...altitudes) - 50);
            const maxAlt = Math.max(...altitudes) + 50;

            function getX(km) {
                return padding.left + (km / dayData.totalKm) * chartW;
            }
            function getY(alt) {
                return padding.top + chartH - ((alt - minAlt) / (maxAlt - minAlt)) * chartH;
            }

            // Grid lines (Crisp Blue Theme)
            ctx.strokeStyle = "rgba(37, 99, 235, 0.12)";
            ctx.lineWidth = 1;
            ctx.fillStyle = "#1e3a8a";
            ctx.font = "bold 11px Plus Jakarta Sans";
            ctx.textAlign = 'right';
            ctx.textBaseline = 'middle';

            const numGridLines = 4;
            for (let i = 0; i <= numGridLines; i++) {
                const val = minAlt + (i / numGridLines) * (maxAlt - minAlt);
                const y = getY(val);
                ctx.beginPath();
                ctx.moveTo(padding.left, y);
                ctx.lineTo(padding.left + chartW, y);
                ctx.stroke();
                ctx.fillText(Math.round(val) + 'm', padding.left - 15, y);
            }

            // Draw KM markers on bottom
            ctx.textAlign = 'center';
            ctx.textBaseline = 'top';
            const kmStep = Math.max(1, Math.ceil(dayData.totalKm / 5));
            for (let km = 0; km <= dayData.totalKm; km += kmStep) {
                const x = getX(km);
                ctx.fillText(km + 'km', x, padding.top + chartH + 15);
            }

            // Gradient filling the elevation profile area with electric light blue look
            const gradient = ctx.createLinearGradient(0, 0, 0, canvas.height);
            gradient.addColorStop(0, "rgba(37, 99, 235, 0.22)");
            gradient.addColorStop(0.5, "rgba(14, 165, 233, 0.08)");
            gradient.addColorStop(1, "rgba(255, 255, 255, 0)");
           
            ctx.beginPath();
            ctx.moveTo(getX(0), padding.top + chartH);
            dayData.points.forEach(p => ctx.lineTo(getX(p.km), getY(p.alt)));
            ctx.lineTo(getX(dayData.totalKm), padding.top + chartH);
            ctx.closePath();
            ctx.fillStyle = gradient;
            ctx.fill();

            // Draw segmented altimetry line (Striking Yellow for Trail, Electric Blue for BTT)
            ctx.lineWidth = 4;
            ctx.lineJoin = "round";
            ctx.lineCap = "round";

            for (let i = 0; i < dayData.points.length - 1; i++) {
                const p1 = dayData.points[i];
                const p2 = dayData.points[i + 1];
                const isTrail = p1.km < dayData.runKm;
                const color = isTrail ? "#f59e0b" : "#2563eb";

                ctx.strokeStyle = color;
                ctx.shadowColor = "rgba(0, 0, 0, 0.05)";
                ctx.shadowBlur = 4;

                ctx.beginPath();
                ctx.moveTo(getX(p1.km), getY(p1.alt));
                ctx.lineTo(getX(p2.km), getY(p2.alt));
                ctx.stroke();
            }
           
            ctx.shadowBlur = 0; // Reset shadow

            // Interactive hover vertical tracker
            if (isHovering && hoverX >= padding.left && hoverX <= padding.left + chartW) {
                const hoverKm = ((hoverX - padding.left) / chartW) * dayData.totalKm;
                const hoverAlt = interpolateElevation(hoverKm, dayData.points);
                const hoverY = getY(hoverAlt);

                // Vertical dashed lines
                ctx.setLineDash([4, 4]);
                ctx.strokeStyle = 'rgba(30, 58, 138, 0.3)';
                ctx.beginPath();
                ctx.moveTo(hoverX, padding.top);
                ctx.lineTo(hoverX, padding.top + chartH);
                ctx.stroke();
                ctx.setLineDash([]);

                // Tracker dot
                ctx.fillStyle = "#2563eb";
                ctx.shadowBlur = 10;
                ctx.shadowColor = "rgba(37, 99, 235, 0.4)";

                ctx.beginPath();
                ctx.arc(hoverX, hoverY, 7, 0, Math.PI * 2);
                ctx.fill();
               
                ctx.shadowBlur = 0;
                ctx.strokeStyle = "#ffffff";
                ctx.lineWidth = 3;
                ctx.stroke();

                updateTooltip(hoverKm, hoverAlt, dayData);
            } else {
                document.getElementById('chart-tooltip').style.opacity = '0';
            }
        }

        function updateTooltip(km, alt, dayData) {
            const tooltip = document.getElementById('chart-tooltip');
            const slope = calculateSlope(km, dayData.points, dayData.totalKm);
           
            tooltip.style.opacity = '1';
           
            const containerRect = document.getElementById('canvas-container').getBoundingClientRect();
            let leftPos = hoverX + 20;
            if (leftPos + 210 > containerRect.width) leftPos = hoverX - 230;
           
            tooltip.style.left = leftPos + 'px';
            tooltip.style.top = '20px';

            document.getElementById('tooltip-km').innerText = km.toFixed(1) + ' km';
            document.getElementById('tooltip-alt').innerText = Math.round(alt) + ' m';
            document.getElementById('tooltip-slope').innerText = slope + ' %';
           
            const typeTag = document.getElementById('tooltip-type');
            if (typeTag) {
                const isTrail = km <= dayData.runKm;
                typeTag.innerText = isTrail ? 'Trail Running' : 'BTT / Gravel';
                typeTag.className = `uppercase text-[9px] px-1.5 py-0.5 rounded font-black ${isTrail ? 'bg-amber-500 text-white' : 'bg-blue-600 text-white'}`;
            }
        }

        function setupCanvasInteraction() {
            const moveHandler = (e) => {
                const rect = canvas.getBoundingClientRect();
                const clientX = e.touches ? e.touches[0].clientX : e.clientX;
                hoverX = clientX - rect.left;
                isHovering = true;
                drawElevationChart();
            };
           
            canvas.addEventListener('mousemove', moveHandler);
            canvas.addEventListener('touchstart', moveHandler);
            canvas.addEventListener('touchmove', moveHandler);
           
            const leaveHandler = () => {
                isHovering = false;
                drawElevationChart();
            };
           
            canvas.addEventListener('mouseleave', leaveHandler);
            canvas.addEventListener('touchend', leaveHandler);
        }

