    <!-- REQUISITS I PREPARACIÓ FÍSICA SECTION (REVOLUTIONARY SPINNER WHEEL) -->
    <section id="preparacio" class="py-24 bg-yellow-100/60 border-t border-yellow-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16">
                <span class="text-accentYellow font-serif text-lg block mb-2 uppercase tracking-wide font-extrabold">2. PREPARACIÓ DE LA RUTA</span>
                <h2 class="font-serif text-3xl sm:text-5xl font-black text-textDark leading-tight uppercase mb-6">
                    REQUISITS I ENTRENAMENT
                </h2>
                <div class="w-24 h-1.5 bg-gradient-to-r from-accentYellow to-amber-400 mx-auto rounded-full"></div>
                <p class="text-textDark mt-6 max-w-2xl mx-auto text-sm sm:text-base font-bold">
                    Selecciona una única ruta i utilitza les fletxes laterals per avançar al següent camí. Només veuràs una ruta activa alhora, amb tots els requisits específics.
                </p>
            </div>

            <!-- Carousel Interface - Single Card Layout -->
            <div class="max-w-4xl mx-auto relative">
