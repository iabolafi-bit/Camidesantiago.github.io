                    <!-- Route Header Section -->
                    <div id="route-carousel-card" class="relative overflow-hidden bg-cover bg-center border-b-2 border-blue-200/60 p-6 transition-all duration-500" style="background-image: linear-gradient(to bottom, rgba(239, 246, 255, 0.92), rgba(219, 234, 254, 0.98)), url('https://images.unsplash.com/photo-1441974231531-c6227db76b6e?auto=format&fit=crop&w=600&q=80');">
                        <div class="absolute inset-0 bg-accentYellow/10 transition-colors"></div>
                        <div class="relative z-10">
                            <div class="flex items-center gap-4 mb-3">
                                <div id="route-carousel-icon" class="w-12 h-12 rounded-xl bg-accentYellow flex items-center justify-center text-white font-black text-lg shadow-md">
                                    <i class="fa-solid fa-flag"></i>
                                </div>
                                <div>
                                    <span id="route-carousel-badge" class="text-[10px] text-accentYellow uppercase tracking-widest font-extrabold">RUTA DELS TEMPLERS</span>
                                    <h4 id="route-carousel-title" class="text-xl font-bold text-textDark">Camí Francès</h4>
                                </div>
                            </div>
