                            <span class="font-bold text-textDark uppercase tracking-wider">Llegenda:</span>
                            <span class="flex items-center gap-2 text-amber-600 font-black">
                                <span class="w-3.5 h-3.5 rounded-sm bg-accentYellow border border-amber-600 block"></span>
                                Trail Running (A Peu)
                            </span>
                            <span class="flex items-center gap-2 text-accentBlue font-black">
                                <span class="w-3.5 h-3.5 rounded-sm bg-accentBlue border border-blue-800 block"></span>
                                BTT / Gravel
                            </span>
                            <span class="text-accentBlue font-mono ml-auto hidden sm:inline">LIVE PLOTTER</span>
                        </div>

                        <!-- CONTENEDOR DEL GRÁFICO -->
                        <div class="relative w-full bg-blue-50/50 rounded-xl border-2 border-blue-200 p-1 mt-2 overflow-hidden select-none shadow-inner" id="canvas-container">

                            <!-- CANVAS -->
                            <canvas id="elevationCanvas" class="w-full block" style="height:350px;"></canvas>

                            <!-- TOOLTIP -->
                            <div id="chart-tooltip" class="absolute bg-slate-900 text-white p-3.5 rounded-xl text-xs shadow-2xl backdrop-blur-md min-w-[210px] opacity-0 pointer-events-none transition-opacity duration-150 z-20">
                                <p class="font-black text-sm mb-1.5 flex items-center justify-between">
                                    <span id="tooltip-title">Detall del Punt</span>
                                    <span id="tooltip-type" class="uppercase text-[9px] px-1.5 py-0.5 rounded font-black bg-yellow-400 text-black">Trail</span>
                                </p>
                                <div class="space-y-1 text-slate-300">
                                    <p class="flex justify-between">
                                        <span>Distància:</span>
                                        <strong class="text-white font-mono" id="tooltip-km">-- km</strong>
                                    </p>
                                    <p class="flex justify-between">
                                        <span>Altitud:</span>
                                        <strong class="text-white font-mono" id="tooltip-alt">-- m</strong>
                                    </p>
                                    <p class="flex justify-between">
                                        <span>Pendent:</span>
                                        <strong class="font-mono text-yellow-400" id="tooltip-slope">-- %</strong>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Dynamic Active Info Bar -->
                    <div id="active-station-detail" class="mt-4 bg-blue-50/80 p-4 rounded-xl border border-blue-200 flex items-center gap-4 transition-all duration-300">
                        <div class="w-10 h-10 rounded-full bg-accentBlue/10 border border-accentBlue/30 flex items-center justify-center text-accentBlue" id="station-icon">
                            <i class="fa-solid fa-flag-checkered text-lg"></i>
                        </div>
                        <div>
                            <p class="text-[10px] text-accentBlue uppercase tracking-wider font-extrabold" id="station-sub">DADES ETAPA ACTIVA</p>
                            <h5 class="text-sm font-bold text-textDark" id="station-name">Etapa 1: Sarria - Portomarín (22.0 KM)</h5>
                            <p class="text-xs text-textMuted mt-0.5 font-semibold" id="station-desc">Dibuix d'altimetria real obtingut mitjançant dades geogràfiques reals de relleu.</p>
