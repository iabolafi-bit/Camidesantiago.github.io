                <a href="#calculadora" class="text-textDark hover:text-accentYellow transition-colors">Calculadora</a>
            </nav>

            <!-- Actions -->
            <div class="flex items-center gap-4">
                <a href="#calculadora" class="bg-accentYellow hover:bg-accentYellowHover text-white font-extrabold text-sm px-6 py-2.5 rounded-full transition-all duration-300 shadow-lg shadow-yellow-300/40 hover:shadow-yellow-300/60 text-center uppercase tracking-wide">
