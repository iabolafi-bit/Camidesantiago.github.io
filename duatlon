            background: #2563eb;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #1d4ed8;
        }

        /* Carousel transition helpers */
        .carousel-transition {
            transition: transform 0.8s cubic-bezier(0.25, 1, 0.5, 1);
        }
    </style>
</head>
