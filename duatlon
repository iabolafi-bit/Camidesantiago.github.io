            <a href="#calculadora" class="block text-textDark hover:text-accentYellow transition-colors py-2 font-bold">Calculadora i Preus</a>
        </div>
    </header>

    <!-- HERO SECTION -->
    <section class="relative min-h-[90vh] flex items-center justify-center py-20 px-4 sm:px-6 lg:px-8 overflow-hidden bg-cover bg-center group" style="background-image: radial-gradient(circle at center, rgba(255, 255, 255, 0.25), rgba(255, 255, 255, 0.06)), url('catedral.png'); filter: saturate(0.95) contrast(1.05);">
        <!-- Energetic color accents (semi-transparent blur rings) -->
        <div class="absolute inset-0 opacity-30 pointer-events-none">
            <div class="absolute top-1/4 left-1/4 w-[400px] h-[400px] bg-blue-400 rounded-full filter blur-[140px]"></div>
            <div class="absolute bottom-1/4 right-1/4 w-[350px] h-[350px] bg-slate-900/10 rounded-full filter blur-[120px]"></div>
            <div class="absolute inset-0 bg-gradient-to-b from-transparent via-white/10 to-black/5"></div>
        </div>

        <!-- Hero Content -->
        <div class="relative max-w-5xl mx-auto text-center z-10 py-8">
